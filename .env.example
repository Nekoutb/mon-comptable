# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend
MC_ENVIRONMENT=development
MC_DATABASE_URL=postgresql+psycopg://mon_comptable:change-me@postgres:5432/mon_comptable
MC_JWT_SECRET=replace-with-at-least-32-random-bytes
MC_STORAGE_ROOT=/data/documents
MC_MAX_UPLOAD_MB=20
MC_REDIS_URL=redis://redis:6379/0
MC_BACKGROUND_MODE=rq
MC_INBOUND_WEBHOOK_SECRET=replace-with-random-webhook-secret
MC_CORS_ORIGINS=http://localhost:3000

# External providers are intentionally disabled until configured.
MC_ERP_PROVIDER=mock
MC_OCR_PROVIDER=mock
MC_EMAIL_PROVIDER=mock
MC_STORAGE_PROVIDER=local
